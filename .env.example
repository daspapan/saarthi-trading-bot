# Saarthi environment variables.
# Copy this file to .env (shared, NO secrets). Exchange keys go ONLY in .env.local,
# which only the executor process loads.

# --- Mode ---------------------------------------------------------------
# backtest | paper | testnet   (there is no live mode)
TRADING_MODE=paper

# --- Storage and config -------------------------------------------------
DB_PATH=./data/saarthi.db
CONFIG_DIR=./config

# --- API ----------------------------------------------------------------
API_PORT=4000
# Default bind is 127.0.0.1. Set ALLOW_LAN=true to reach the dashboard from your phone
# on home Wi-Fi. LAN access needs PIN_HASH to be set.
API_HOST=127.0.0.1
ALLOW_LAN=false

# --- PIN (stored hashed, never plain) ------------------------------------
# Create it with:  npm run pin:hash -- 123456   and paste the output here.
PIN_HASH=
# PIN=   <- never set a plain PIN. Startup refuses to run if this variable exists.

# --- Exchanges (testnet / demo only; startup refuses anything else) ------
BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_WS_URL=wss://stream.testnet.binance.vision/ws
BYBIT_ENABLED=false
BYBIT_BASE_URL=https://api-demo.bybit.com

# Second, read-only price feed used only to cross-check prices (no keys).
PRICE_CHECK_WS_URL=wss://stream.bybit.com/v5/public/spot

# Two years of candles for backtests (npm run candles:download). Market data only, no keys.
HISTORY_BASE_URL=https://data-api.binance.vision
CANDLES_DIR=./data/candles

# --- AI analyst (Ollama) -------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
ANALYSIS_INTERVAL_MIN=15

# --- Logging -------------------------------------------------------------
LOG_LEVEL=info
# Readable, coloured logs in the terminal (pino-pretty). Set to false for raw JSON lines.
LOG_PRETTY=true

# --- .env.local ONLY (read by the executor, never by anything else) -------
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# --- Web dashboard -------------------------------------------------------
# Where Next.js forwards /backend/* requests.
SAARTHI_API_URL=http://127.0.0.1:4000
